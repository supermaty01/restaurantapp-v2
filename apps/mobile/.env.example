# Copiar a .env y rellenar. Las EXPO_PUBLIC_* se incrustan en el bundle al
# compilar, así que tienen que existir también en EAS (ver docs/13):
#   eas env:create --scope project --name EXPO_PUBLIC_SUPABASE_URL --value "..."
#
# app.config.js falla la build si falta alguna de las tres obligatorias, en vez
# de producir un APK que se instala y no llega a ningún sitio.

# --- Obligatorias ---
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publicable (`sb_publishable_…`). No es secreta: RLS es lo que protege.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# El Worker desplegado. Sirve las fotos y los enlaces compartidos.
EXPO_PUBLIC_API_URL=https://restaurantapp-api.TU-CUENTA.workers.dev

# --- Opcionales ---
# Autocompletado de sitios al crear un restaurante.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
# Mapa nativo de Android. Sin ella el mapa sale en gris.
GOOGLE_MAPS_API_KEY=
