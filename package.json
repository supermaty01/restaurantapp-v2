{
  "name": "restaurant-app-v2",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mobile": "npm run -w apps/mobile start",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:ci": "npm run test:ci --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:ci",
    "prepare": "husky",
    "start": "npm run -w apps/mobile start",
    "db:test": "node supabase/tests/run.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "react": "19.2.3"
  },
  "_lint-staged": "Solo formato aquí. El lint vive en cada workspace, con su .lintstagedrc.json: ESLint 9 busca la configuración desde el directorio de trabajo, y en la raíz de un monorepo no hay ninguna. Correrlo desde aquí fallaba con 'couldn't find an eslint.config' sobre cualquier fichero de apps/.",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.27.0",
    "lightningcss-darwin-arm64": "1.27.0"
  }
}
