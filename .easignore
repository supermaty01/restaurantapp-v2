# Qué NO sube a EAS.
#
# Sin este fichero EAS sube todo lo que no esté en .gitignore, y eso incluye
# `.git` entero con su historia: el archivo de build pesaba 334 MB. Nada de lo
# que hay aquí participa en construir el APK.
#
# Ojo con lo que NO está en esta lista: `packages/shared` sí lo importa la app
# en runtime (services/share/importService.ts), así que el paquete entero no
# puede excluirse — solo sus tests.

# Historia de git: lo más pesado con diferencia
.git/

# Documentación
docs/
*.md

# Backend y base de datos: se despliegan aparte
apps/api/
supabase/
scripts/

# Cobertura y artefactos de test
coverage/
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.test.sql
**/*.node.test.ts
apps/mobile/jest.config.js
apps/mobile/jest.setup.ts
apps/mobile/jest.setup.node.ts

# Configuración de editor / herramientas
.idea/
.vscode/
.husky/
.github/
.expo/
.wrangler/
